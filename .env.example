# Settings for `docker compose` (copy to .env and fill in). Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ------------------------------------------------------------ database
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sandbox_db_oan

# ---------------------------------------------------------------- auth
JWT_ACCESS_TOKEN_KEY=
JWT_REFRESH_TOKEN_KEY=

# ---------------------------------------------------- public addresses
# Where users' browsers reach the web app and the API. On a server use the
# real host names, e.g. https://sandbox.example.org and https://api.example.org/oan.
# PUBLIC_API_URL is built into the web image: rebuild `web` after changing it.
PUBLIC_API_URL=http://localhost:8010/oan
# Address the web server (Next.js) uses to reach the API inside Docker for the
# public pages (catalogue, FAQs, terms, home). Read at run time, no rebuild needed.
API_INTERNAL_URL=http://api:8000/oan
ALLOWED_ORIGINS=http://localhost:3005
PORTAL_URL=http://localhost:3005

# ------------------------------------------------------ host ports
API_HOST_PORT=8010
WEB_HOST_PORT=3005
POSTGRES_HOST_PORT=5433
# Postgres listens on loopback only unless changed.
POSTGRES_BIND=127.0.0.1

# ----------------------------------------------------------------- app
APP_ENV=sandbox
API_DEBUG=false
DEFAULT_COUNTRY_CODE=ET
SITE_NAME=Open Agri Net
LOG_LEVEL=INFO

# ----------------------------------------------------------------- mail
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openagrinet.org
SMTP_TLS=true
# While MAIL_ENABLED=false every sign-up verification code is DEV_FIXED_OTP
# (6 digits), because no email can be sent. Ignored when mail is on or ENV=production.
# Leave empty to always generate random codes.
DEV_FIXED_OTP=000000

# ------------------------------------------------------- api gateway
# The gateway is not started by this stack. Set the proxy URL (not the Admin
# API) of the Apache APISIX already deployed for the environment (dev / staging),
# e.g. https://apisix-dev.example.org
# Laptop test with a local gateway on the Docker host: http://host.docker.internal:9080
GATEWAY_ENABLED=true
GATEWAY_SANDBOX_URL=
GATEWAY_UAT_URL=
GATEWAY_PROD_URL=

# ------------------------------------------------- clean-database mode
# By default the first start loads deployment/postgres/initdb (sandbox data).
# For an empty database set POSTGRES_INITDB_DIR=./deployment/postgres/empty and
# SEED_ADMIN_PASSWORD (creates the admin, masters, CMS; idempotent);
# LOAD_DEMO_CATALOGUE=true also adds the A2C and OpenG2P products.
POSTGRES_INITDB_DIR=./deployment/postgres/initdb
SEED_ADMIN_EMAIL=admin@openagrinet.org
SEED_ADMIN_PASSWORD=
LOAD_DEMO_CATALOGUE=false

# ------------------------------------------------------- image names
IMAGE_PREFIX=oan-sandbox
IMAGE_TAG=latest
